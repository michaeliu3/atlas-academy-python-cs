{
  "name": "atlas-academy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:modules": "node scripts/sync-modules.mjs",
    "validate:course": "node scripts/validate-course.mjs",
    "validate:course:strict": "node scripts/validate-course.mjs --strict",
    "validate:course:inputs": "node scripts/validate-course.mjs --require-git-tracked",
    "check:generated": "node scripts/check-generated.mjs",
    "types:worker": "wrangler types worker-configuration.d.ts --check",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm sync:modules",
    "dev": "vinext dev",
    "prebuild": "pnpm sync:modules",
    "build": "vinext build",
    "start": "vinext start",
    "test": "pnpm build && node --test tests/course-contract.test.mjs tests/course-graph.test.mjs tests/release-inputs.test.mjs tests/local-progress-codec.test.mjs tests/http-security-headers.test.mjs tests/rich-rendering.test.mjs tests/diagnostic-model.test.mjs tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work --ignore-pattern worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "drizzle-orm": "0.45.2",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.1",
    "mermaid": "^11.16.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.115.0"
  },
  "type": "module"
}
