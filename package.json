{
  "name": "atlas-academy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:modules": "node scripts/sync-modules.mjs",
    "validate:course": "node scripts/validate-course.mjs",
    "validate:course:content": "node scripts/validate-course.mjs --content",
    "validate:course:strict": "node scripts/validate-course.mjs --strict",
    "validate:course:complete": "node scripts/validate-course.mjs --complete",
    "validate:course:inputs": "node scripts/validate-course.mjs --require-git-tracked",
    "validate:mermaid-alternatives": "node scripts/validate-mermaid-alternatives.mjs",
    "validate:mermaid-alternatives:complete": "node scripts/validate-mermaid-alternatives.mjs --require-complete",
    "generate:teaching-packs": "node scripts/generate-module-teaching-packs.mjs",
    "check:teaching-packs": "node scripts/generate-module-teaching-packs.mjs --check",
    "validate:teaching-packs": "node scripts/validate-teaching-packs.mjs",
    "generate:arc-projects": "node scripts/generate-arc-projects.mjs",
    "check:arc-projects": "node scripts/generate-arc-projects.mjs --check",
    "validate:arc-projects": "node scripts/validate-arc-projects.mjs",
    "generate:coverage": "node scripts/generate-module-delivery-coverage.mjs",
    "check:coverage": "node scripts/generate-module-delivery-coverage.mjs --check",
    "render:pdf": "node scripts/render-module-pdfs.mjs",
    "validate:pdf": "node scripts/validate-module-pdfs.mjs",
    "test:pdf-contract": "node --test tests/pdf-pipeline-contract.test.mjs",
    "validate:browser-progress": "node scripts/browser-progress-surface-policy.mjs",
    "validate:built-downloads": "node scripts/validate-built-downloads.mjs",
    "validate:performance-budget": "node scripts/validate-client-performance-budget.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "generate:goal-compliance": "node scripts/generate-goal-compliance.mjs",
    "check:goal-compliance": "node scripts/generate-goal-compliance.mjs --check",
    "check:source-links": "node scripts/check-source-links.mjs",
    "check:source-links:live": "node scripts/check-source-links.mjs --live",
    "types:worker": "wrangler types worker-configuration.d.ts --check",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm sync:modules",
    "dev": "vinext dev",
    "prebuild": "pnpm sync:modules && pnpm validate:browser-progress",
    "build": "vinext build && pnpm validate:built-downloads && pnpm validate:performance-budget",
    "start": "vinext start",
    "test": "pnpm build && node scripts/run-course-tests.mjs",
    "test:content": "node scripts/run-course-tests.mjs --suite=content",
    "test:apparatus": "node scripts/run-course-tests.mjs --suite=apparatus",
    "test:release": "node scripts/run-course-tests.mjs --suite=release",
    "test:browser": "pnpm build && playwright test",
    "test:browser:ci": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work --ignore-pattern .wrangler --ignore-pattern playwright-report --ignore-pattern test-results --ignore-pattern worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "drizzle-orm": "0.45.2",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.1",
    "mermaid": "^11.16.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.48.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "js-yaml": "4.3.0",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.115.0"
  },
  "type": "module"
}
