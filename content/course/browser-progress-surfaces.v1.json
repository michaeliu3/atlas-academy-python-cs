{
  "schemaVersion": 1,
  "policyVersion": "v1",
  "kind": "atlas-browser-progress-surface-policy",
  "purpose": "Allow only bounded, optional, local learner-progress records. Prediction-triad record paths name a fixed gate whose only persisted fields are an allowlisted choice, confidence, and reveal flag. These records are untrusted and are never identity, mastery, authorization, Notion, transcript, oral-defense, route-unlock, or pass/fail evidence.",
  "scope": {
    "sourceRoots": ["app", "lib"],
    "browserStorageAdapterPath": "lib/browser-progress-storage.js",
    "forbiddenApis": ["sessionStorage"],
    "forbiddenMethods": ["clear"],
    "requiredEnvelopeKeys": ["version", "record"],
    "forbiddenDataClasses": [
      "learner-text",
      "names-or-identifiers",
      "timestamps",
      "navigation-or-completion-state",
      "results-or-scores",
      "export-consent",
      "raw-transcript",
      "credentials",
      "policy-or-capability-state"
    ]
  },
  "surfaces": [
    {
      "id": "intake",
      "owner": { "moduleId": "intake", "lifecycle": "published-foundation" },
      "route": "/diagnostic",
      "clientPaths": ["app/diagnostic/DiagnosticExperience.tsx"],
      "adapter": {
        "path": "lib/diagnostic-progress-codec.js",
        "codecExport": "diagnosticProgressCodec",
        "operations": ["restoreDiagnosticProgress", "persistDiagnosticProgress", "clearDiagnosticProgress"]
      },
      "current": {
        "key": "atlas-academy:diagnostic:intermediate-advanced-v3",
        "keyVersion": 3,
        "envelopeVersion": 3,
        "codecKind": "prediction-triads",
        "recordPaths": [
          "python-state-aliasing", "recursion-termination", "adt-observation-contract", "cost-hidden-membership",
          "lazy-shared-cursor", "hash-key-stability", "bfs-discovery-timing", "architecture-dependency-direction",
          "debugging-flaky-evidence", "agent-retry-review", "artifact-pickle-boundary", "sql-three-valued-logic",
          "transaction-replay-identity", "memory-locality-cache-lines", "quantifier-scope-countermodel",
          "linear-algebra-basis-coordinates", "calculus-gradient-local-change", "probability-conditional-evidence",
          "optimization-feasible-descent", "ml-evaluation-leakage"
        ],
        "allowedDataClasses": ["fixed-choice-id", "confidence", "reveal-flag"],
        "meaningfulWriteOnly": true,
        "maxSerializedBytes": 4096
      },
      "legacy": [
        {
          "key": "atlas-academy:diagnostic:intermediate-advanced-v2",
          "keyVersion": 2,
          "strategy": "migrate-meaningful-current-first",
          "fallbackWhenCurrentPresent": false
        }
      ],
      "reset": {
        "removeKeys": [
          "atlas-academy:diagnostic:intermediate-advanced-v3",
          "atlas-academy:diagnostic:intermediate-advanced-v2"
        ]
      },
      "tests": { "unit": "tests/diagnostic-progress-codec.test.mjs", "browser": "e2e/accessibility.spec.ts" }
    },
