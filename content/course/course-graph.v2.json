  "knowledgeArcs": [
    {
      "id": "arc-i",
      "numeral": "I",
      "title": "Computation & reasoning",
      "range": "Modules 1–5",
      "description": "Build the execution, abstraction, proof, and cost models that every later system depends on."
    },
    {
      "id": "arc-ii",
      "numeral": "II",
      "title": "Data & algorithms",
      "range": "Modules 6–11",
      "description": "Connect representation choices to operations, invariants, performance, and algorithmic strategy."
    },
    {
      "id": "arc-iii",
      "numeral": "III",
      "title": "Durable software",
      "range": "Modules 12–16",
      "description": "Turn local reasoning into stable APIs, evidence, maintainable architecture, delivery, and transactions."
    },
    {
      "id": "arc-iv",
      "numeral": "IV",
      "title": "Machine & network",
      "range": "Modules 17–22",
      "description": "Connect machine execution and OS mediation to concurrent histories, protocols, partial failure, and trust boundaries."
    },
    {
      "id": "arc-v",
      "numeral": "V",
      "title": "Languages & intelligence",
      "range": "Modules 23–26",
      "description": "Derive language meaning and runtime evidence before human-centered intelligent systems and capstone defense."
    },
    {
      "id": "arc-vi",
      "numeral": "VI",
      "title": "Mathematical foundations",
      "range": "Modules 27–31",
      "description": "Deepen proof, representation, continuous change, probability, optimization, and information."
    },
    {
      "id": "arc-vii",
      "numeral": "VII",
      "title": "Theory & learning systems",
      "range": "Modules 32–36",
      "description": "Connect systems languages, computation limits, classical AI, machine learning, and reliable learning systems."
    }
  ],
  "routePlans": [
    {
      "id": "atlas-core-60",
      "days": 60,
      "intakeDay": 1,
      "phases": [
        {
          "id": "claims",
          "number": "I",
          "title": "Execution, claims, and discrete structure",
          "premise": "Before a system can be designed or optimized, model state and make claims precise enough to prove or refute.",
          "gate": "Defend one invariant, repair one flawed proof, construct a smallest counterexample, and name the cost model of the check.",
          "moduleNumbers": [
            1,
            2,
            3,
            4,
            5,
            27
          ],
          "schedule": {
            "startDay": 2,
            "endDay": 9
          }
        },
        {
          "id": "algorithms",
          "number": "II",
          "title": "Representation and algorithmic strategy",
          "premise": "A representation decides which operations are cheap, which invariants are local, and which strategy the structure permits.",
          "gate": "Read an unfamiliar data-structure implementation, recover its invariant, compare strategies, and defend a cost/evidence boundary.",
          "moduleNumbers": [
            6,
            7,
            8,
            9,
            10,
            11
          ],
          "schedule": {
            "startDay": 10,
            "endDay": 17
          }
        },
        {
          "id": "software",
          "number": "III",
          "title": "Durable software and shared data",
          "premise": "Local algorithms become useful when contracts, tests, artifacts, and transactions preserve meaning over time.",
          "gate": "Trace a claim through an interface, test, and data boundary; diagnose one failed change; defend a repair with regression evidence.",
          "moduleNumbers": [
            12,
            13,
            14,
            15,
            16
          ],
          "schedule": {
            "startDay": 18,
            "endDay": 25
          }
        },
        {
          "id": "mathematics",
          "number": "IV",
          "title": "Execution, numerical models, and evidence",
          "premise": "Machine behavior, linear structure, continuous change, uncertainty, and optimization explain what a numerical or ML claim can mean.",
          "gate": "Derive a projection or likelihood step, name a numerical/data assumption, reject an overclaim, and explain what evidence would change it.",
          "moduleNumbers": [
            17,
            28,
            29,
            30,
            31
          ],
          "schedule": {
            "startDay": 26,
            "endDay": 34
          }
        },
        {
          "id": "systems",
          "number": "V",
          "title": "Machine, network, and runtime boundaries",
          "premise": "Applications live inside machines, processes, schedules, networks, and trust boundaries; each changes what can be known.",
          "gate": "Read a trace across system layers, name an ownership/failure boundary, and reject a claim the observation cannot establish.",
          "moduleNumbers": [
            18,
            19,
            20,
            21,
            22,
            23,
            24
          ],
          "schedule": {
            "startDay": 35,
            "endDay": 44
          }
        },
        {
          "id": "intelligence",
          "number": "VI",
          "title": "Formal theory, classical AI, and learning",
          "premise": "AI joins language, search, decision, representation, statistics, execution limits, and evidence rather than a single model call.",
          "gate": "Model a problem before selecting an algorithm or model; identify an assumption, data boundary, and transfer risk.",
          "moduleNumbers": [
            32,
            33,
            34,
            35,
            36
          ],
          "schedule": {
            "startDay": 45,
            "endDay": 53
          }
        },
        {
          "id": "evidence",
          "number": "VII",
          "title": "Evidence and human control",
          "premise": "A model or agent is useful only when its assumptions, authority, feedback, and uncertainty remain inspectable and challengeable.",
          "gate": "Produce an evidence-and-human-control packet naming the claim, limitation, owner, and next falsifier.",
          "moduleNumbers": [
            25
          ],
          "schedule": {
            "startDay": 54,
            "endDay": 55
          }
        },
        {
          "id": "defense",
          "number": "VIII",
          "title": "Capstone release and oral architecture defense",
          "premise": "A maintained release must connect mathematical argument, implementation evidence, tests, security, human impact, and revisable decisions.",
          "gate": "Defend a versioned evidence bundle: claim, trace, test/observation, human impact, limitation, rollback, and next reason to revise.",
          "moduleNumbers": [
            26
          ],
          "schedule": {
            "startDay": 56,
            "endDay": 60
          }
        }
      ]
    }
  ],
